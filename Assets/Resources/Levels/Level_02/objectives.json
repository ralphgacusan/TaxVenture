{
  "_readme": [
    "Level 2 uses three short objective chapters; Notes shows one chapter at a readable size.",
    "Triggers retain the full gameplay milestones. The active HUD step remains automatic."
  ],
  "objectives": [
    {
      "title": "Check Rosa’s folder",
      "steps": [
        {
          "text": "Check in for today’s review.",
          "trigger": "event:ReceptionistTalkedTo"
        },
        {
          "text": "Collect Rosa’s folder.",
          "trigger": "event:CaseFolderRetrieved"
        },
        {
          "text": "Open the folder at your desk.",
          "trigger": "state:ReviewDocumentsState"
        },
        {
          "text": "Link the clue on the Findings slip.",
          "trigger": "event:FindingRecorded"
        },
        {
          "text": "Stamp the initial review.",
          "trigger": "event:PreliminaryHoldStamped"
        }
      ]
    },
    {
      "title": "Mark the Money!",
      "steps": [
        {
          "text": "Collect Rosa’s records at Stall 04.",
          "trigger": "event:RosaRecordsCollected"
        },
        {
          "text": "Sit at the records desk.",
          "trigger": "event:MarketDeskOpened"
        },
        {
          "text": "Practise with Arthur’s payslip.",
          "trigger": "event:AnnotationTutorialCompleted"
        },
        {
          "text": "Mark four records. CHECK opens Rosa's talk; CHECK again grades.",
          "trigger": "event:AnnotationsChecked"
        },
        {
          "text": "Correct the red notes.",
          "trigger": "event:IncomeQuestCompleted"
        }
      ]
    },
    {
      "title": "Finish the review",
      "steps": [
        {
          "text": "Restore the missing entry on the schedule.",
          "trigger": "event:OfficeReviewCompleted"
        },
        {
          "text": "Stamp your final assessment.",
          "trigger": "event:FinalAssessmentStamped",
          "undoneBy": "event:AuditReturned"
        },
        {
          "text": "Talk to the Auditor; hand over the folder for approval.",
          "trigger": "state:CaseCompleteState"
        },
        {
          "text": "Collect the approved Client Copy beside the Auditor.",
          "trigger": "event:ClientCopyPickedUp"
        },
        {
          "text": "Deliver the Client Copy to Rosa in the conference room.",
          "trigger": "event:ClientCopyHandedOver"
        }
      ]
    }
  ]
}
