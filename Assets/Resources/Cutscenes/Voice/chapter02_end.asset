  entries:
  - id: vo_ch02_end_01_rosa_responsible
    speaker: "Rosa"
    text: "You checked it with me. Thank you."
    variant: "rosa.responsible_completed"
    clip: {fileID: 8300000, guid: eae1def861bc4943956b44b813abc55a, type: 3}
  - id: vo_ch02_end_01_rosa_promise
    speaker: "Rosa"
    text: "Next time, please check before you promise."
    variant: "rosa.promise_resolved"
    clip: {fileID: 8300000, guid: 1be893d803dd4fadb8f991e242ee0ba5, type: 3}
  - id: vo_ch02_end_01_rosa_dismissive
    speaker: "Rosa"
    text: "Thank you for finishing the review."
    variant: "rosa.dismissive_completed"
    clip: {fileID: 8300000, guid: a0fa68e33c524194b8de2c8616bf360c, type: 3}
  - id: vo_ch02_end_01_rosa_neutral
    speaker: "Rosa"
    text: "Thank you for explaining the corrected copy."
    variant: "rosa.neutral"
    clip: {fileID: 8300000, guid: 11e92b60f1834332bd4fe4029fbb1e6d, type: 3}
  - id: vo_ch02_end_02_receptionist
    speaker: "Receptionist"
    text: "Bea's next. She's bringing her receipts."
    variant: ""
    clip: {fileID: 8300000, guid: 81d92c2c0df743f29e982988455b831a, type: 3}
