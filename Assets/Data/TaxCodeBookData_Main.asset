%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1bf5fd56daae6224299eebd748d911eb, type: 3}
  m_Name: TaxCodeBookData_Main
  m_EditorClassIdentifier: Assembly-CSharp::TaxCodeBookData
  sections:
  - heading: "Section 1 \u2013 Taxpayer Classification"
    body: '

      A Filipino citizen residing in the Philippines.

      Taxable
      on income in and outside the Philippines.




      A Filipino citizen residing
      or working abroad.

      Taxable only on income earned within the Philippines.




      A
      foreign national residing in the Philippines.

      Taxable only on income
      earned within the Philippines.




      A foreign national not residing in
      the Philippines.

      Taxable only on income earned within the Philippines.


'
    clickableValues:
    - displayText: Resident Citizen
      enumValue: ResidentCitizen
      type: 2
      semanticKey: ResidencyStatus
    - displayText: Non-Resident Citizen
      enumValue: NonResidentCitizen
      type: 2
      semanticKey: ResidencyStatus
    - displayText: Resident Alien
      enumValue: ResidentAlien
      type: 2
      semanticKey: ResidencyStatus
    - displayText: Non-Resident Alien
      enumValue: NonResidentAlien
      type: 2
      semanticKey: ResidencyStatus
  - heading: "Section 2 \u2013 Taxpayer Type"
    body: '

      Earns income from employment.

      

      

      

      

      

      Earns
      income from operating a business.

      

      

      

      

      

      Earns
      income from providing professional services independently.

      

      

      

      

      Earns
      both employment income and business or professional income.

      

'
    clickableValues:
    - displayText: Compensation Earner
      enumValue: CompensationEarner
      type: 2
      semanticKey: TaxpayerType
    - displayText: Self-Employed
      enumValue: SelfEmployed
      type: 2
      semanticKey: TaxpayerType
    - displayText: Professional
      enumValue: Professional
      type: 2
      semanticKey: TaxpayerType
    - displayText: Mixed Income Earner
      enumValue: MixedIncomeEarner
      type: 2
      semanticKey: TaxpayerType
  - heading: "Section 3 \u2013 Income Sources"
    body: '

      Income received from an employer.

      

      

      

      

      

      Income
      earned from business activities.

      

      

      

      

      

      Income
      earned from professional services.

      

      

      

      

      

      Combination
      of multiple income sources.

      

'
    clickableValues:
    - displayText: Employment Income
      enumValue: EmploymentIncome
      type: 2
      semanticKey: IncomeSource
    - displayText: Business Income
      enumValue: BusinessIncome
      type: 2
      semanticKey: IncomeSource
    - displayText: Professional Income
      enumValue: ProfessionalIncome
      type: 2
      semanticKey: IncomeSource
    - displayText: Mixed Income
      enumValue: MixedIncome
      type: 2
      semanticKey: IncomeSource
